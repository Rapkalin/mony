{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
    {{ form_start(itemForm) }}
        <h1 class="title">Add new expense</h1>
        <div class="inputs-container">
            <div class="form-input">
                {{ form_label(itemForm.name, 'Name', {
                    'label_attr': {'class': 'hidden'}
                }) }}
                {{ form_widget(itemForm.name) }}
            </div>
            <div class="form-input">
                {{ form_label(itemForm.price, 'Enter a price', {
                    'label_attr': {'class': 'hidden'}
                }) }}
                {{ form_widget(itemForm.price) }}
            </div>
            <div class="form-input">
                {{ form_label(itemForm.date, 'Date', {
                    'label_attr': {'class': 'hidden'}
                }) }}
                {{ form_widget(itemForm.date) }}
            </div>
            <div class="form-input">
                {{ form_label(itemForm.category, 'Category', {
                    'label_attr': {'class': 'hidden'}
                }) }}
                {{ form_widget(itemForm.category) }}
            </div>
            <div class="form-input">
                {{ form_label(itemForm.newCategory, 'Add a new category', {
                    'label_attr': {'class': 'hidden'}
                }) }}
                {{ form_widget(itemForm.newCategory) }}
            </div>
        </div>

        <button type="submit" class="button-cta">Register</button>
    {{ form_end(itemForm) }}

{% endblock %}

{% extends 'base.html.twig' %}

{% block body %}
    <div class="container">
        <div class="left-side">

            <div class="other">
                <div class="balance">
                    <h3>Remaining balance</h3>
                    <div class="price">1250€</div>
                    <div class="summary">
                        <div id="summary-income" class="summary-container">
                            <p class="summary-title">Income this month</p>
                            <p class="summary-price price-income">3500,00</p>
                        </div>
                        <div id="summary-expense" class="summary-container">
                            <p class="summary-title">Expenses this month</p>

{% extends 'base.html.twig' %}

{% block body %}
    <h1>Welcome {{ user.name }}</h1>

    {% if user.expenses is defined %}
        {% include './components/expense-cards.html.twig' with {
            expenses: user.expenses
        } %}
    {% else %}
        <div class="container">
            <div>No expense found</div>
            <a class="button-cta" href="{{ path('add_expense') }}">Add expense</a>
        </div>
    {% endif %}
{% endblock %}
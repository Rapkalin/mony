{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
    {{ form_start(expenseForm) }}
        <h1 class="title">Add new expense</h1>
        <div class="inputs-container">
            <div class="form-input">
                {{ form_label(expenseForm.name, 'Name', {
                    'label_attr': {'class': 'hidden'}
                }) }}
                {{ form_widget(expenseForm.name) }}
            </div>
            <div class="form-input">
                {{ form_label(expenseForm.price, 'Enter a price', {
                    'label_attr': {'class': 'hidden'}
                }) }}
                {{ form_widget(expenseForm.price) }}
            </div>
            <div class="form-input">
                {{ form_label(expenseForm.date, 'Date', {
                    'label_attr': {'class': 'hidden'}
                }) }}
                {{ form_widget(expenseForm.date) }}
            </div>
            <div class="form-input">
                {{ form_label(expenseForm.category, 'Category', {
                    'label_attr': {'class': 'hidden'}
                }) }}
                {{ form_widget(expenseForm.category) }}
            </div>
            <div class="form-input">
                {{ form_label(expenseForm.newCategory, 'Add a new category', {
                    'label_attr': {'class': 'hidden'}
                }) }}
                {{ form_widget(expenseForm.newCategory) }}
            </div>
        </div>

        <button type="submit" class="button-cta">Register</button>
    {{ form_end(expenseForm) }}

{% endblock %}
